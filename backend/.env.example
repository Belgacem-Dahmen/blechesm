# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# En prod (Railway PostgreSQL) :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── Auth JWT ─────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ADMIN_SECRET="remplacer_par_64_bytes_random_hex"
JWT_CLIENT_SECRET="remplacer_par_64_bytes_random_hex_different"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Replicate IA (prod uniquement) ───────────────────────────────────────────
REPLICATE_API_TOKEN=""

# ─── Resend emails ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
ADMIN_EMAIL="belgacem.dahmen@gmail.com"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
